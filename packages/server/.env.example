DATABASE_URL="file:./dev.db"
PORT=4000
# HOST=127.0.0.1 in production once behind trustmail's backend — defaults
# to all interfaces so local dev needs no config.
CORS_ORIGIN="*"

# Trustmail-hosted deployment only (see auth.ts's resolveMasterKeyApp and
# TRUSTMAIL_SERVICE_GUIDE.md §3). When set, requests carrying a matching
# x-webchat-master header + x-trustmail-org header authenticate as that
# org's App, auto-provisioning one on first sight — no separate signup step.
# Leave unset for standalone/self-hosted use; existing x-app-secret auth is
# unaffected either way. Generate once with: openssl rand -hex 32
# WEBCHAT_MASTER_KEY=

# Optional — file attachments (chat/team-chat uploads). Falls back to local
# disk under packages/server/uploads when unset. Same var names as
# akoti-mail's own lib/s3Storage.js, so this is a drop-in against the same
# MinIO instance/bucket once deployed alongside it — see
# packages/server/src/storage.ts.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_USE_SSL=true
