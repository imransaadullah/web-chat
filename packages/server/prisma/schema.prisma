// Prisma schema for web-chat's backend.
// SQLite for zero-friction local dev; swap the datasource to Postgres for
// production (change provider + url, nothing else changes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model App {
  id            String         @id @default(cuid())
  name          String
  publicKey     String         @unique
  secretKey     String         @unique
  webhookUrl    String?
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  contexts      Context[]
}

model Conversation {
  id                String    @id @default(cuid())
  appId             String
  app               App       @relation(fields: [appId], references: [id])
  status            String    @default("open") // open | pending | ticket | closed
  visitorId         String
  visitorName       String?
  visitorEmail      String?
  initialContextId  String?
  assignedAgentId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  messages          Message[]
  ticket            Ticket?

  @@index([appId, status])
}

model Context {
  id         String   @id @default(cuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id])
  kind       String
  title      String
  summary    String?
  url        String?
  data       String? // JSON-encoded
  snapshot   String? // JSON-encoded ContextSnapshotField[]
  capturedAt DateTime @default(now())

  @@index([appId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  authorType     String // visitor | agent | system
  authorId       String
  type           String // text | context_card | system
  body           String?
  contextId      String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Ticket {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  title          String
  externalRef    String?
  externalUrl    String?
  createdAt      DateTime     @default(now())
}
